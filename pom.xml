<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <properties>
    <project.build.sourceEncoding>utf-8</project.build.sourceEncoding>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <groupId>org.fairsim</groupId>
  <artifactId>fairSIM</artifactId>
  <!-- placeholder, not maintained: the version is the git tag on the built commit -->
  <version>0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>fairSIM</name>
  <description>Free Analysis and Interactive Reconstruction for Structured Illumination Microscopy</description>
  <url>http://www.fairsim.org</url>
  <inceptionYear>2013</inceptionYear>

  <licenses>
    <license>
      <name>GNU General Public License</name>
      <url>https://gnu.org/licenses/gpl.html</url>
      <distribution>repo</distribution>
      <comments>Version 2 of the License or (at your option) any later version.</comments>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Marcel Müller</name>
      <email>muellerphysics@gmail.com</email>
      <roles>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/fairSIM/fairSIM</connection>
    <developerConnection>scm:git:git@github.com:fairSIM/fairSIM</developerConnection>
    <tag>HEAD</tag>
    <url>http://github.com/fairSIM/fairSIM</url>
  </scm>
  <issueManagement>
    <system>GitHub Issues</system>
    <url>http://github.com/fairSIM/fairSIM/issues</url>
  </issueManagement>


  <repositories>
    <repository>
      <id>imagej.public</id>
      <url>http://maven.imagej.net/content/groups/public</url>
    </repository>
    <repository>
      <id>fairsim.org</id>
      <url>https://github.com/fairSIM</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
      <version>1.48v</version>
      <scope>provided</scope>
    </dependency>

    <dependency>
	<groupId>com.github.wendykierp</groupId>
	<artifactId>JTransforms</artifactId>
	<version>3.1</version>
    </dependency>

    <!-- Test dependencies (5.11.x: last line with a Java 8 baseline) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>

    <!-- ImageJ plugins need an underscore on the filename of the jar. -->
    <finalName>${project.artifactId}_plugin_mvn-${buildNumber}</finalName>

    <resources>
      <resource>
          <directory>src/main/resources</directory>
          <filtering>true</filtering>
          <includes>
            <include>git-version-maven.txt</include>
          </includes>
          <targetPath>org/fairsim</targetPath>
      </resource>
      <resource>
          <directory>src/main/resources</directory>
          <filtering>false</filtering>
          <targetPath>org/fairsim/resources</targetPath>
          <includes>
            <include>*.svg</include>
            <include>*.png</include>
            <include>*.html</include>
            <include>third-party-licenses.txt</include>
          </includes>
      </resource>
      <resource>
        <directory>./</directory>
        <filtering>false</filtering>
        <includes>
          <include>plugins.config</include>
        </includes>
        <targetPath>./</targetPath>
      </resource>
    </resources>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <!--
          Since Maven 3, we really need to specify a version number for
          plugins, but RELEASE and LATEST are only valid for dependencies.
        -->
        <version>2.3.2</version>
        <configuration>
          <source>1.8</source>
          <target>1.8</target>
	        <!-- this keeps the forked/internal version of JTransform from being build
	        with maven dependencies, we can just rely on the original being there instead -->
	        <excludes>
	          <exclude>org/fairsim/linalg/JTransformsForkConnector.java</exclude>
	        </excludes>
	      </configuration>
      </plugin>


      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <systemPropertyVariables>
            <java.awt.headless>true</java.awt.headless>
          </systemPropertyVariables>
        </configuration>
      </plugin>

      <!-- bundle JTransforms and its dependencies, relocated, so the plugin
           jar runs on any ImageJ / Fiji independent of their copies -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <minimizeJar>true</minimizeJar>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <relocations>
                <relocation>
                  <pattern>org.jtransforms</pattern>
                  <shadedPattern>org.fairsim.extern.shaded.jtransforms</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>pl.edu.icm.jlargearrays</pattern>
                  <shadedPattern>org.fairsim.extern.shaded.jlargearrays</shadedPattern>
                </relocation>
                <relocation>
                  <pattern>org.apache.commons.math3</pattern>
                  <shadedPattern>org.fairsim.extern.shaded.math3</shadedPattern>
                </relocation>
              </relocations>
              <!-- their notices are in resources/third-party-licenses.txt -->
              <filters>
                <filter>
                  <artifact>org.apache.commons:commons-math3</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE.txt</exclude>
                    <exclude>META-INF/NOTICE.txt</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- version: the git tag on HEAD, or 'n/a' (same as the Makefile) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>git-tag-version</id>
            <phase>validate</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <exportAntProperties>true</exportAntProperties>
              <target>
                <exec executable="git" outputproperty="git.tags" failifexecutionfails="false">
                  <arg value="tag" />
                  <arg value="--points-at" />
                  <arg value="HEAD" />
                </exec>
                <loadresource property="git.tag" quiet="true">
                  <propertyresource name="git.tags" />
                  <filterchain>
                    <headfilter lines="1" />
                    <striplinebreaks />
                  </filterchain>
                </loadresource>
                <condition property="fairsim.version" value="${git.tag}" else="n/a">
                  <isset property="git.tag" />
                </condition>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>buildnumber-maven-plugin</artifactId>
        <version>1.4</version>
        <executions>
          <execution>
            <phase>validate</phase>
            <goals>
              <goal>create</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
        	<doCheck>false</doCheck>
		      <doUpdate>false</doUpdate>
		      <shortRevisionLength>10</shortRevisionLength>
	      </configuration>
      </plugin>

      <!-- Javadoc and Sources attachments are OSSRH requirements -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>2.2.1</version>
	      <configuration>
	        <excludeResources>true</excludeResources>
	        <includes>
		        <include>org/fairsim/**/*.java</include>
		        <include>org/fairsim/resources/*</include>
	        </includes>
	        <excludes>
		        <exclude>target</exclude>
		        <exclude>org/fairsim/linalg/JTransformsForkConnector.java</exclude>
	        </excludes>
	      </configuration>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar-no-fork</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>2.10.2</version>
	      <configuration>
	        <additionalparam>-Xdoclint:none</additionalparam>
	        <quiet>true</quiet>
	        <source>8</source>
	        <!-- <sourcepath>${basedir}</sourcepath> -->
	        <excludePackageNames>org.fairsim.extern.jtransforms</excludePackageNames>
	        <sourceFileExcludes>
		        <exclude>org/fairsim/linalg/*.java</exclude>
	        </sourceFileExcludes> 
	      </configuration>
	      <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

     </plugins>
  </build>
</project>
